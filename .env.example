# Zkopírujte do souboru .env (setup to udělá automaticky).
# Databáze SQLite – soubor prisma/crm.db
DATABASE_URL="file:./crm.db"
# Tajný klíč pro přihlašovací cookie – na serveru nastavte vlastní dlouhý náhodný řetězec.
SESSION_SECRET="zmente-me-na-dlouhy-nahodny-retezec-alespon-32-znaku"
# Účty vytvořené příkazem "npm run setup". Admin se přihlásí jménem "admin" nebo e-mailem ADMIN_EMAIL.
ADMIN_EMAIL="admin@2melektro.eu"
ADMIN_PASSWORD="admin"
TEST_USER_PASSWORD="ZmenHeslo-Test1"
# Na serveru s HTTPS nastavte na 1 (cookie se pak posílá jen šifrovaně).
COOKIE_SECURE="0"

# --- E-maily ---
# Ověření přihlášení kódem z e-mailu (1 = zapnuto, 0 = jen heslo)
LOGIN_EMAIL_CODE="1"
# Odesílatel e-mailů
MAIL_FROM="CRM 2M elektro <crm@2melektro.eu>"
# SMTP server. Prázdné = e-maily zůstanou v místní schránce CRM a kód se vypíše do okna aplikace.
# Pro Mailpit na localhostu: SMTP_HOST="localhost", SMTP_PORT="1025"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# 1 = šifrované spojení od začátku (port 465)
SMTP_SECURE="0"
